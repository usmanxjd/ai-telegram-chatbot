# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Hugging Face API token with inference permission
HUGGINGFACEHUB_API_TOKEN=your-hf-api-key

# Text generation model available via Hugging Face Inference Endpoint
HF_LLM_REPO_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Optional: set to false to disable retrieval over local docs
ENABLE_RAG=true

# Optional: folder containing support docs markdown/txt files
KNOWLEDGE_BASE_DIR=data/knowledge_base

# Optional: persisted FAISS vector index
VECTORSTORE_DIR=vectorstore

# Optional: retrieval count
RETRIEVAL_TOP_K=4
